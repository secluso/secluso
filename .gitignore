target

# Exclude RustRover and Mac-based meta files
.DS_Store
.idea


# Exclude reproducible build work
.repro-work
.pnpm-store

# Exclude all credential, video or state based data
user_credentials
user_credentials_qrcode.png
camera_secret
camera_secret_qrcode.png
pending_videos
pending_thumbnails
sample_data
current_version
wifi_password
example_app_data
state
test_data
cameras.yaml
credentials_full
*.sh
!update/scripts/secluso_sign_checksums.sh

# Firebase Service Files
google-services.json
GoogleService-Info.plist
service_account_key.json

# Exclude GPG test-release credentials and related
.gnupg
*.zip
release_work
*.asc
secluso-v*

# Exclude local release staging outputs and imported signing material
/releases/release_assets/
*.p12
__pycache__
*.wic
metadata.json

# Exclude Cargo.lock files that are not meant to be checked into git
app_native/Cargo.lock
client_lib/Cargo.lock
client_server_lib/Cargo.lock
motion_ai/pipeline/Cargo.lock
motion_ai/cli/Cargo.lock
server_backbone/Cargo.lock
tester/Cargo.lock
# Per-camera object naming secret
object_secret
subscription_uuid
